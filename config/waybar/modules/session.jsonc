{
    "group/session": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500, 
            "transition-left-to-right": false,
            "click-to-reveal": true,
        },
        "modules": [
            "custom/logo",
            "custom/poweroff",
            "custom/reboot",
            "custom/logout",
            "custom/lock"
        ],
        "cursor": true
    },

    "custom/logo": {
        "format": "󰣇",
        "tooltip": false,
    },

    "custom/poweroff": {
        "format": "",
        "tooltip": false,
        "on-click": "poweroff"
    },

    "custom/reboot": {
        "format": "",
        "tooltip": false,
        "on-click": "reboot"
    },

    "custom/logout": {
        "format": "󰍃",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    },

    "custom/lock": {
        "format": "",
        "tooltip": false,
        "on-click": "hyprlock"
    }
}

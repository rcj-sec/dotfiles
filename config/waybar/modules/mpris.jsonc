{
    "mpris": {
        "format": "{player_icon}{dynamic}",
        "format-paused": "{status_icon}<i>{dynamic}</i>",
        "dynamic-order": ["title"],
        "title-len": 15,
        "on-click-right": "swaync-client -op",
        "player-icons": {
            "default": " ",
            "spotify": " ",
            "firefox": " "
        },
        "status-icons": {
            "paused": " "
        },
        "tooltip-format": "Via {player}"
        // "ignored-players": ["firefox"]
    }
}
